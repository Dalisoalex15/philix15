# Database
DATABASE_URL=postgresql://philix:philix_secure_pass@localhost:5432/philix_db

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-here
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-chars

# App
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# AWS S3 (for document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=philix-documents
AWS_REGION=af-south-1
